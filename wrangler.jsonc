{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moss-newapi-home",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}